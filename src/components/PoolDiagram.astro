---
/**
 * Plan-view illustrations for pool types that have no Luxepool project photo yet.
 * Drawn like an architect's plan: hairlines, dimension ticks, water in the brand gradient.
 * Always captioned "איור תכנון" in the card, never presented as a photo.
 */
interface Props {
  kind: 'favorit' | 'fiberglass' | 'natural' | 'rooftop';
  title: string;
}
const { kind, title } = Astro.props;
const id = `pd-${kind}`;
// Gravel dots around the regeneration zone, as one path.
const gravel = Array.from({ length: 46 }, (_, i) => {
  const a = (i / 46) * Math.PI * 2;
  const r = 128 + ((i * 53) % 17);
  const x = 202 + Math.cos(a) * r * 0.66;
  const y = 252 + Math.sin(a) * r;
  return `M${(x - 1.4).toFixed(1)} ${y.toFixed(1)}a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0 -2.8 0`;
}).join('');
---
<svg class="pd" viewBox="0 0 400 500" role="img" aria-label={title} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={`${id}-water`} x1="0.85" y1="0" x2="0.2" y2="1">
      <stop offset="0" stop-color="#9BE3F4" />
      <stop offset="0.45" stop-color="#4FB2E0" />
      <stop offset="1" stop-color="#1C5198" />
    </linearGradient>
    <linearGradient id={`${id}-shallow`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D6F6FC" />
      <stop offset="1" stop-color="#9BE3F4" />
    </linearGradient>
    <pattern id={`${id}-grid`} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="#1B2430" stroke-opacity="0.06" stroke-width="0.6" />
    </pattern>
    <pattern id={`${id}-hatch`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0V6" stroke="#1B2430" stroke-opacity="0.35" stroke-width="0.8" />
    </pattern>
  </defs>

  <rect width="400" height="500" fill="#F5F8FB" />
  <rect width="400" height="500" fill={`url(#${id}-grid)`} />

  {kind === 'favorit' && (
    <g>
      {/* coping */}
      <rect x="118" y="78" width="164" height="344" rx="30" fill="#fff" stroke="#1B2430" stroke-opacity="0.18" />
      {/* one-piece ceramic shell */}
      <rect x="132" y="92" width="136" height="316" rx="22" fill={`url(#${id}-water)`} />
      {/* integrated corner steps */}
      <path d="M154 92h-0a22 22 0 0 0-22 22v58c26 0 48-14 58-36s4-44 4-44z" fill={`url(#${id}-shallow)`} opacity="0.9" />
      <path d="M132 150c22 0 40-12 44-32M132 128c12 0 20-6 24-18" fill="none" stroke="#fff" stroke-width="1.2" opacity="0.9" />
      {/* bench along the long side */}
      <rect x="248" y="200" width="20" height="150" rx="6" fill="#BDEFF9" opacity="0.75" />
      <rect x="132" y="92" width="136" height="316" rx="22" fill="none" stroke="#1B2430" stroke-opacity="0.55" stroke-width="1.2" />
      <path d="M150 300c22-10 44 8 66-2s30-14 44-6M146 360c26-8 40 6 64 0s34-12 52-4M160 240c18-8 34 6 52 0" fill="none" stroke="#fff" stroke-opacity="0.45" stroke-width="1.4" stroke-linecap="round" />
      {/* dimension ticks */}
      <g stroke="#1B2430" stroke-opacity="0.45" stroke-width="0.9">
        <path d="M96 92v316M90 92h12M90 408h12" />
        <path d="M132 446h136M132 440v12M268 440v12" />
      </g>
    </g>
  )}

  {kind === 'fiberglass' && (
    <g>
      <path d="M120 120a80 80 0 0 1 160 0v290a14 14 0 0 1-14 14H134a14 14 0 0 1-14-14z" fill="#fff" stroke="#1B2430" stroke-opacity="0.18" />
      <path d="M134 124a66 66 0 0 1 132 0v280a6 6 0 0 1-6 6H140a6 6 0 0 1-6-6z" fill={`url(#${id}-water)`} />
      {/* roman-end steps: concentric arcs */}
      <path d="M134 124a66 66 0 0 1 132 0z" fill={`url(#${id}-shallow)`} opacity="0.92" />
      <path d="M152 124a48 48 0 0 1 96 0M170 124a30 30 0 0 1 60 0" fill="none" stroke="#fff" stroke-width="1.2" />
      <path d="M134 124h132" stroke="#fff" stroke-width="1.2" />
      <path d="M134 124a66 66 0 0 1 132 0v280a6 6 0 0 1-6 6H140a6 6 0 0 1-6-6z" fill="none" stroke="#1B2430" stroke-opacity="0.55" stroke-width="1.2" />
      <path d="M150 260c22-10 44 8 66-2s30-14 44-6M148 330c26-8 40 6 64 0s34-12 52-4M160 200c18-8 34 6 52 0" fill="none" stroke="#fff" stroke-opacity="0.45" stroke-width="1.4" stroke-linecap="round" />
      <g stroke="#1B2430" stroke-opacity="0.45" stroke-width="0.9">
        <path d="M100 58v352M94 58h12M94 410h12" />
        <path d="M134 448h132M134 442v12M266 442v12" />
      </g>
    </g>
  )}

  {kind === 'natural' && (
    <g>
      {/* regeneration zone: organic outline with planting */}
      <path d="M96 118c30-44 132-58 196-30 52 22 62 92 50 160-10 60 4 110-36 150-44 44-150 46-196 6-40-34-30-98-36-150-6-50-8-100 22-136z" fill={`url(#${id}-shallow)`} stroke="#1B2430" stroke-opacity="0.35" stroke-width="1" />
      {/* swimming zone */}
      <rect x="150" y="150" width="104" height="206" rx="10" fill={`url(#${id}-water)`} stroke="#1B2430" stroke-opacity="0.55" stroke-width="1.2" />
      <path d="M164 260c16-8 32 6 48 0s22-10 32-4M166 310c18-6 30 4 46 0s24-8 34-2" fill="none" stroke="#fff" stroke-opacity="0.45" stroke-width="1.4" stroke-linecap="round" />
      {/* plant symbols */}
      {[
        [118, 170], [124, 236], [116, 300], [128, 362], [176, 412], [236, 410], [290, 384], [300, 316], [304, 246], [296, 178], [250, 116], [182, 112],
      ].map(([x, y], i) => (
        <g transform={`translate(${x} ${y}) rotate(${i * 37})`} stroke="#1C5198" stroke-opacity="0.55" fill="none" stroke-width="0.9">
          <circle r={i % 3 === 0 ? 13 : 9} fill="#fff" fill-opacity="0.55" />
          <path d="M0-13V13M-13 0H13M-9-9 9 9M9-9-9 9" stroke-opacity="0.35" />
        </g>
      ))}
      {/* gravel */}
      <path d={gravel} fill="#1B2430" fill-opacity="0.22" />
      <g stroke="#1B2430" stroke-opacity="0.45" stroke-width="0.9">
        <path d="M150 380h104M150 374v12M254 374v12" />
      </g>
    </g>
  )}

  {kind === 'rooftop' && (
    <g>
      {/* building slab edge + parapet */}
      <rect x="40" y="58" width="320" height="384" fill="#fff" stroke="#1B2430" stroke-opacity="0.2" />
      <rect x="40" y="418" width="320" height="24" fill={`url(#${id}-hatch)`} stroke="#1B2430" stroke-opacity="0.45" />
      {/* structural grid (columns below) */}
      <g fill="#1B2430" fill-opacity="0.18">
        {[80, 200, 320].flatMap((x) => [110, 250, 390].map((y) => <rect x={x - 5} y={y - 5} width="10" height="10" />))}
      </g>
      <g stroke="#1B2430" stroke-opacity="0.08" stroke-dasharray="4 5">
        <path d="M80 58v384M200 58v384M320 58v384M40 110h320M40 250h320M40 390h320" />
      </g>
      {/* deck boards */}
      <g stroke="#1B2430" stroke-opacity="0.07">
        {Array.from({ length: 18 }, (_, i) => <path d={`M40 ${70 + i * 20}h320`} />)}
      </g>
      {/* pool against the glass edge */}
      <rect x="208" y="90" width="122" height="300" fill={`url(#${id}-water)`} />
      <path d="M222 220c16-8 32 6 48 0s22-10 32-4M222 290c18-6 30 4 46 0s24-8 34-2" fill="none" stroke="#fff" stroke-opacity="0.45" stroke-width="1.4" stroke-linecap="round" />
      <rect x="208" y="90" width="122" height="300" fill="none" stroke="#1B2430" stroke-opacity="0.55" stroke-width="1.2" />
      {/* glass wall on the open side */}
      <path d="M336 84v312M342 84v312" stroke="#0090D7" stroke-width="1.4" />
      <g stroke="#0090D7" stroke-width="0.9">
        {Array.from({ length: 8 }, (_, i) => <path d={`M336 ${100 + i * 40}h6`} />)}
      </g>
      <g stroke="#1B2430" stroke-opacity="0.45" stroke-width="0.9">
        <path d="M208 70h122M208 64v12M330 64v12" />
      </g>
    </g>
  )}
</svg>

<style>
  .pd {
    inline-size: 100%;
    block-size: 100%;
  }
</style>

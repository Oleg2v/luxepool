---
/**
 * 9 · Footer on Luxepool blue — the white logo lives here, as the brief asks.
 */
import Icon from './Icon.astro';
import { company, phones, socials } from '@/data/site';
import { waLink, quoteMessage } from '@/lib/whatsapp';
import { defaultDesign } from '@/lib/store';

const wa = waLink(quoteMessage({ poolType: null, design: defaultDesign(), designTouched: false }));
---
<footer class="ft" aria-labelledby="ft-title">
  <h2 id="ft-title" class="sr-only">פרטי קשר ומידע</h2>
  <div class="container ft__grid">
    <div class="ft__brand">
      <img src={company.logoWhite} alt="לוקספול שירותי בריכות" width="799" height="231" loading="lazy" decoding="async" class="ft__logo" />
      <p class="ft__tag">החלום שלך, המומחיות שלנו.<br />יותר מ-20 שנה, הכל תחת קורת גג אחת.</p>
    </div>

    <div class="ft__col">
      <h3 class="ft__h">בניית בריכה חדשה</h3>
      <ul>
        <li><a href={`tel:${phones.build.tel}`}><span class="ltr num">{phones.build.display}</span></a></li>
        <li><a href={wa} data-wa="quote" target="_blank" rel="noopener">וואטסאפ <span class="ltr num">{phones.buildWhatsApp.display}</span></a></li>
      </ul>
    </div>

    <div class="ft__col">
      <h3 class="ft__h">שירות וציוד</h3>
      <ul>
        <li><a href={`tel:${phones.service.tel}`}><span class="ltr num">{phones.service.display}</span></a></li>
        <li><a href={company.shopUrl} target="_blank" rel="noopener">חנות אונליין <span class="ltr">{company.shopLabel}</span></a></li>
      </ul>
    </div>

    <div class="ft__col">
      <h3 class="ft__h">משרד</h3>
      <ul>
        <li><a href={`mailto:${company.email}`}><span class="ltr">{company.email}</span></a></li>
        <li>
          <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('יהלום 1 אשדוד')}`} target="_blank" rel="noopener">
            {company.addressHe}
          </a>
        </li>
      </ul>
      <ul class="ft__social" aria-label="רשתות חברתיות">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <Icon name={s.id} size={20} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container ft__bottom">
    <p>© {company.nameHe}</p>
    <a href="/accessibility/">הצהרת נגישות</a>
    <p class="ft__concept" lang="en" dir="ltr">Design concept. Not the official Luxepool website.</p>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    color: rgb(255 255 255 / 0.9);
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(110 193 228 / 0.35), transparent 55%),
      linear-gradient(200deg, #1c5198 0%, #153f78 100%);
    padding-block: clamp(64px, 8vw, 112px) 28px;
  }

  .ft a {
    color: #fff;
    text-decoration: none;
  }

  .ft a:hover {
    text-decoration: underline;
  }

  .ft :focus-visible {
    outline-color: #fff;
  }

  .ft__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
  }

  .ft__logo {
    inline-size: 180px;
    block-size: auto;
  }

  .ft__tag {
    margin-block-start: 18px;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.88);
  }

  .ft__h {
    font: 600 0.8125rem / 1.3 var(--f-ui);
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.85);
    margin-block-end: 12px;
  }

  .ft__col ul {
    display: grid;
    gap: 8px;
    font-size: 1rem;
  }

  .ft__social {
    display: flex !important;
    gap: 6px !important;
    margin-block-start: 18px;
  }

  .ft__social a {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.35);
    transition: background-color 0.3s, border-color 0.3s;
  }

  .ft__social a:hover {
    background: rgb(255 255 255 / 0.12);
    border-color: #fff;
  }

  .ft__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    margin-block-start: clamp(48px, 6vw, 80px);
    padding-block-start: 22px;
    border-block-start: 1px solid rgb(255 255 255 / 0.22);
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.85);
  }

  .ft__bottom a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .ft__concept {
    margin-inline-start: auto;
    color: rgb(255 255 255 / 0.85);
  }

  @media (min-width: 768px) {
    .ft__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  @media (max-width: 767px) {
    .ft {
      padding-block-end: 96px; /* room for the floating WhatsApp button */
    }
    .ft__concept {
      margin-inline-start: 0;
    }
  }
</style>

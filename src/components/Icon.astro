---
/**
 * Inline SVG icons (no icon font, no requests). Decorative by default (aria-hidden);
 * pass `label` to expose an accessible name.
 */
interface Props {
  name:
    | 'whatsapp' | 'phone' | 'mail' | 'pin' | 'arrow' | 'arrow-out' | 'star' | 'check'
    | 'menu' | 'close' | 'pause' | 'play' | 'chevron' | 'facebook' | 'instagram'
    | 'tiktok' | 'youtube' | 'drop';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: cls, label } = Astro.props;

// Stroke icons use currentColor at 1.5px; brand glyphs are filled.
const paths: Record<Props['name'], string> = {
  whatsapp:
    '<path fill="currentColor" d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01Zm-7.01 15.24h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.22-8.23 8.22Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z"/>',
  phone:
    '<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M5.2 3.5h3l1.6 4-2 1.3a10.8 10.8 0 0 0 5.4 5.4l1.3-2 4 1.6v3a1.8 1.8 0 0 1-1.9 1.8C9.6 18.1 5.9 14.4 5.4 7.4A1.8 1.8 0 0 1 7.2 5.5"/>',
  mail:
    '<rect x="3.5" y="5.5" width="17" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  pin:
    '<path fill="none" stroke="currentColor" stroke-width="1.5" d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 1 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  // Points to the inline-end; .icon-flip-rtl mirrors it in RTL (see style below).
  arrow:
    '<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m-6-6 6 6-6 6"/>',
  'arrow-out':
    '<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8"/>',
  star:
    '<path fill="currentColor" d="m12 2.8 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.6l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8L12 2.8Z"/>',
  check:
    '<path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="m5 12.5 4.2 4.2L19 7"/>',
  menu:
    '<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M4 8h16M4 16h16"/>',
  close:
    '<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="m6 6 12 12M18 6 6 18"/>',
  pause:
    '<path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" d="M9 6v12M15 6v12"/>',
  play:
    '<path fill="currentColor" d="M8 5.5v13a.6.6 0 0 0 .9.5l10.3-6.5a.6.6 0 0 0 0-1L8.9 5a.6.6 0 0 0-.9.5Z"/>',
  chevron:
    '<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>',
  facebook:
    '<path fill="currentColor" d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1Z"/>',
  instagram:
    '<rect x="3.75" y="3.75" width="16.5" height="16.5" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3.9" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.2" cy="6.8" r="1.05" fill="currentColor"/>',
  tiktok:
    '<path fill="currentColor" d="M16.6 3h-3.1v12.2a2.7 2.7 0 1 1-2.7-2.7c.3 0 .6 0 .8.1V9.4a5.9 5.9 0 1 0 5 5.8V9.1a7.5 7.5 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-4.3-4.4Z"/>',
  youtube:
    '<path fill="currentColor" d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2 27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z"/>',
  drop:
    '<path fill="none" stroke="currentColor" stroke-width="1.5" d="M12 3.5s6 6.4 6 10.6a6 6 0 0 1-12 0c0-4.2 6-10.6 6-10.6Z"/>',
};
const flip = name === 'arrow' || name === 'chevron';
---
<svg
  class:list={['icon', cls, { 'icon-flip-rtl': flip }]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name]}
/>
<style is:global>
  /* Directional icons are drawn pointing right; mirror them in RTL so "next" points forward. */
  [dir='rtl'] .icon-flip-rtl {
    transform: scaleX(-1);
  }
</style>

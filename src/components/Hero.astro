---
/**
 * 1 · Hero — "the surface".
 * White deck, a pool cut into the page, live water (three.js) that the cursor or finger
 * disturbs. The still poster is a frame of the same shader, so the switch to live water
 * is seamless, and it is the fallback for reduced motion and low-power devices.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import heroPoster from '@/assets/posters/hero-water.jpg';
import { company } from '@/data/site';
import { waLink, quoteMessage } from '@/lib/whatsapp';
import { defaultDesign } from '@/lib/store';

const wa = waLink(quoteMessage({ poolType: null, design: defaultDesign(), designTouched: false }));
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__head">
      <p class="eyebrow hero__eyebrow">בניית בריכות שחייה · אשדוד</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line"><span>החלום שלך,</span></span>
        <span class="hero__line"><span>המומחיות שלנו.</span></span>
      </h1>
    </div>

    <div class="hero__aside">
      <p class="hero__lead">
        יותר מ-20 שנה אנחנו מתכננים, בונים ומתחזקים כל סוג של בריכה, הכל תחת קורת גג אחת.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#contact" data-cta-quote>קבלו הצעת מחיר</a>
        <a class="btn btn--ghost" href={wa} data-wa="quote" target="_blank" rel="noopener">
          <Icon name="whatsapp" class="wa-glyph" />
          וואטסאפ
          <span class="sr-only">(נפתח בחלון חדש)</span>
        </a>
      </div>
      <ul class="hero__trust" aria-label="למה לוקספול">
        <li>
          <span class="hero__stat num ltr">{company.googleRating}</span>
          <span class="hero__stat-label">
            <span class="hero__stars" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={11} />)}
            </span>
            בגוגל
          </span>
        </li>
        <li>
          <span class="hero__stat num ltr">{company.googleReviews}</span>
          <span class="hero__stat-label">ביקורות</span>
        </li>
        <li>
          <span class="hero__stat hero__stat--name">האח הגדול</span>
          <span class="hero__stat-label">בנינו את הבריכה ב-2023 וב-2025</span>
        </li>
      </ul>
    </div>

    <div class="hero__pool" data-hero-pool>
      <div class="hero__water" data-hero-host>
        <Picture
          src={heroPoster}
          formats={['avif', 'webp']}
          widths={[560, 760, 1000, 1400]}
          quality={58}
          sizes="(min-width: 1024px) 56vw, 100vw"
          fallbackFormat="webp"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero__poster"
          pictureAttributes={{ class: 'hero__poster-pic' }}
        />
        <div class="hero__ripples" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
      <button class="hero__pause" type="button" aria-pressed="false" data-hero-pause hidden>
        <span class="hero__pause-icon hero__pause-icon--pause"><Icon name="pause" size={16} /></span>
        <span class="hero__pause-icon hero__pause-icon--play"><Icon name="play" size={14} /></span>
        <span class="sr-only" data-hero-pause-label>עצירת תנועת המים</span>
      </button>
      <p class="hero__pool-note" aria-hidden="true"><span class="ltr num">±0.00</span> מפלס מים</p>
    </div>
  </div>
</section>

<style>
  .hero {
    --hero-pad-top: calc(var(--header-h) + clamp(20px, 4.5vh, 88px));
    position: relative;
    display: flex;
    min-block-size: max(100svh, 640px);
    padding-block-start: var(--hero-pad-top);
    background: var(--c-white);
    /* Bleed amount from the container edge to the viewport edge. */
    --bleed: calc((100vw - min(100vw, var(--maxw))) / 2 + var(--margin));
  }

  .hero__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto 1fr;
    column-gap: var(--gutter);
    inline-size: 100%;
  }

  .hero__head {
    grid-column: 1 / -1;
  }

  .hero__eyebrow {
    margin-block-end: clamp(16px, 2.4vh, 28px);
  }

  .hero__title {
    font-size: var(--t-hero);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    /* room for descenders inside the reveal mask */
    padding-block-end: 0.06em;
    margin-block-end: -0.06em;
    white-space: nowrap;
  }

  .hero__line > span {
    display: inline-block;
  }

  .motion .hero__line > span {
    animation: hero-line 1.25s var(--ease-out) both;
  }

  .motion .hero__line:nth-child(2) > span {
    animation-delay: 0.12s;
  }

  @keyframes hero-line {
    from {
      transform: translate3d(0, 104%, 0);
    }
  }

  .hero__aside {
    grid-column: 1 / -1;
    display: grid;
    align-content: start;
    gap: 20px;
    padding-block: 18px 24px;
  }

  .motion .hero__aside > * {
    animation: hero-fade 1s var(--ease-out) both;
  }
  .motion .hero__aside > :nth-child(1) { animation-delay: 0.32s; }
  .motion .hero__aside > :nth-child(2) { animation-delay: 0.42s; }
  .motion .hero__aside > :nth-child(3) { animation-delay: 0.52s; }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }
  }

  .hero__lead {
    max-inline-size: 30ch;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--c-body);
    /* reserve lines so a late font swap can't shift the buttons */
    min-block-size: calc(3 * 1.6em);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero__ctas .btn {
    flex: 1 1 auto;
  }

  .hero__trust {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    padding-block-start: 18px;
    border-block-start: 1px solid var(--c-line);
  }

  .hero__trust li {
    display: grid;
    align-content: start;
    gap: 4px;
    padding-inline: 0 clamp(14px, 2.2vw, 24px);
  }

  .hero__trust li + li {
    padding-inline-start: clamp(14px, 2.2vw, 24px);
    border-inline-start: 1px solid var(--c-line);
  }

  .hero__stat {
    font: 300 clamp(1.5rem, 1.25rem + 0.8vw, 1.875rem) / 1 'Inter Tight', var(--f-ui);
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }

  .hero__stat--name {
    font-family: var(--f-display);
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
    letter-spacing: 0;
    white-space: nowrap;
  }

  .hero__stat-label {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--c-body);
    text-wrap: balance;
  }

  .hero__stars {
    display: inline-flex;
    gap: 1px;
    margin-inline-end: 4px;
    vertical-align: -1px;
    color: var(--c-mid);
  }

  /* ----------------------------------------------------------- the pool */
  .hero__pool {
    position: relative;
    grid-column: 1 / -1;
    min-block-size: 300px;
    margin-inline-end: calc(-1 * var(--bleed));
    /* the coping: a pale stone band with a hairline, visible on the top and start sides */
    border-block-start: 11px solid var(--c-mist);
    border-inline-start: 11px solid var(--c-mist);
    box-shadow:
      0 -1px 0 var(--c-line),
      1px 0 0 var(--c-line);
  }

  .hero__water {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #6ec1e4;
    box-shadow: inset 0 0 0 1px rgb(27 36 48 / 0.08);
    isolation: isolate;
  }

  .hero__water :global(.hero__poster-pic),
  .hero__water :global(.hero__poster) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .hero__water :global(.hero__poster) {
    object-fit: cover;
    /* physical on purpose: the still is framed on the pool's top-right corner, like the shader */
    object-position: right top;
  }

  .hero__water :global(.hero-water__canvas) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
    z-index: 1;
  }

  .hero__pool.is-live .hero__water :global(.hero-water__canvas) {
    opacity: 1;
  }

  /* Still fallback: a CSS ripple near the steps. */
  .hero__ripples {
    position: absolute;
    inset-block-start: 7%;
    right: 14%;
    inline-size: 1px;
    block-size: 1px;
    z-index: 2;
    display: none;
  }

  .hero__pool.is-still .hero__ripples {
    display: block;
  }

  .hero__ripples i {
    position: absolute;
    inset: -110px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.55);
    box-shadow:
      0 0 0 1px rgb(28 81 152 / 0.07),
      inset 0 0 18px rgb(255 255 255 / 0.18);
    transform: scale(0.08);
    opacity: 0;
    animation: ripple 6.5s cubic-bezier(0.25, 0.6, 0.3, 1) infinite;
  }

  .hero__ripples i:nth-child(2) { animation-delay: 1.1s; }
  .hero__ripples i:nth-child(3) { animation-delay: 2.2s; }

  @keyframes ripple {
    0% { transform: scale(0.08); opacity: 0; }
    12% { opacity: 0.95; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  .hero__pool.is-paused .hero__ripples i {
    animation-play-state: paused;
  }

  /* Reduced motion: the ripple is drawn, not animated. */
  @media (prefers-reduced-motion: reduce) {
    .hero__ripples i {
      animation: none;
      opacity: 0.7;
    }
    .hero__ripples i:nth-child(1) { transform: scale(0.45); }
    .hero__ripples i:nth-child(2) { transform: scale(0.85); opacity: 0.45; }
    .hero__ripples i:nth-child(3) { transform: scale(1.3); opacity: 0.25; }
  }

  .hero__pause {
    position: absolute;
    z-index: 3;
    inset-block-end: 16px;
    inset-inline-start: 16px;
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--c-ink);
    box-shadow: 0 6px 18px -8px rgb(27 36 48 / 0.35);
    transition: transform 0.4s var(--ease-out), background-color 0.3s;
  }

  .hero__pause:hover {
    transform: scale(1.06);
    background: #fff;
  }

  .hero__pause-icon {
    grid-area: 1 / 1;
    display: grid;
  }

  .hero__pause-icon--play,
  .hero__pause[aria-pressed='true'] .hero__pause-icon--pause {
    display: none;
  }

  .hero__pause[aria-pressed='true'] .hero__pause-icon--play {
    display: grid;
  }

  .hero__pool-note {
    position: absolute;
    inset-block-start: -34px;
    inset-inline-start: -11px;
    display: none;
    gap: 8px;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--c-body);
  }

  /* ----------------------------------------------------------- desktop */
  @media (min-width: 1024px) {
    .hero__head {
      grid-column: 1 / 11;
      grid-row: 1;
    }
    .hero__aside {
      grid-column: 1 / 6;
      grid-row: 2 / 4;
      padding-block: clamp(32px, 5vh, 56px) 48px;
      gap: 28px;
    }
    .hero__lead {
      min-block-size: calc(3 * 1.6em);
    }
    .hero__ctas .btn {
      flex: 0 0 auto;
    }
    .hero__pool {
      grid-column: 7 / -1;
      grid-row: 2 / 4;
      margin-block-start: clamp(36px, 6vh, 64px);
      min-block-size: 360px;
    }
    .hero__pool-note {
      display: flex;
    }
  }

  @media (min-width: 1024px) and (max-height: 760px) {
    .hero__pool {
      margin-block-start: 28px;
    }
  }
</style>

<script>
  import { canRunLiveGL, idle, isPosterMode, reducedMotion, yieldToMain } from '@/lib/device';
  import type { HeroWater } from '@/lib/three/hero-water';

  const pool = document.querySelector<HTMLElement>('[data-hero-pool]')!;
  const host = pool.querySelector<HTMLElement>('[data-hero-host]')!;
  const pauseBtn = pool.querySelector<HTMLButtonElement>('[data-hero-pause]')!;
  const pauseLabel = pool.querySelector<HTMLElement>('[data-hero-pause-label]')!;
  const params = new URLSearchParams(location.search);
  const poster = isPosterMode();

  let water: HeroWater | null = null;
  let paused = false;

  function showStill(animated: boolean) {
    pool.classList.add('is-still');
    pool.classList.remove('is-live');
    pauseBtn.hidden = !animated;
  }

  pauseBtn.addEventListener('click', () => {
    paused = !paused;
    pauseBtn.setAttribute('aria-pressed', String(paused));
    pauseLabel.textContent = paused ? 'הפעלת תנועת המים' : 'עצירת תנועת המים';
    pool.classList.toggle('is-paused', paused);
    water?.setUserPaused(paused);
  });

  async function startLive() {
    try {
      const { createHeroWater } = await import('@/lib/three/hero-water');
      await yieldToMain();
      water = createHeroWater(host, {
        poster,
        allowSoftware: params.has('forcegl'),
        onReady: () => {
          pool.classList.add('is-live');
          pauseBtn.hidden = poster;
          if (poster) document.documentElement.dataset.posterReady = 'true';
        },
        onFail: () => {
          water?.dispose();
          water = null;
          showStill(true);
        },
      });
    } catch {
      showStill(true);
    }
  }

  if (poster) {
    // Poster renderer: the water fills a square viewport, everything else is covered.
    document.documentElement.classList.add('poster-mode');
    host.style.cssText = 'position:fixed;inset:0;z-index:9999;width:100vw;height:100vh;';
    startLive();
  } else if (reducedMotion()) {
    showStill(false);
  } else {
    // Live water loads after the page is interactive; the still is identical until then.
    const go = () =>
      idle(2000).then(() => {
        if (canRunLiveGL()) startLive();
        else showStill(true);
      });
    if (document.readyState === 'complete') go();
    else window.addEventListener('load', go, { once: true });
  }
</script>

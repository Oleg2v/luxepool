# Optional, build time. By default the quote form posts to the site's own endpoint
# /api/quote (Cloudflare Worker → D1 database "luxepool-leads").
# Set this only to send the form to an external webhook instead (e.g. when the static
# build in dist/client is hosted somewhere without the Worker).
PUBLIC_QUOTE_WEBHOOK_URL=

# Server-side forwarding of stored leads is configured on the Worker, not here:
#   Worker variable/secret QUOTE_WEBHOOK_URL (Cloudflare dashboard or `npx wrangler secret put QUOTE_WEBHOOK_URL`).
